<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Testes de carga: concorrência, volume, soak (longa duração) e carga HTTP na API de exemplo.
    Nenhum roda no CI de push: todos rodam pelo performance.yml, manual; os pesados têm [Explicit] e só rodam quando selecionados por filtro
    (veja docs/testes.md). Framework, lock file e auditoria de pacotes em ../Directory.Build.props.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- CA5394: Random com semente fixa é proposital (sorteios reproduzíveis de carga/fuzzing), não é uso de segurança -->
    <NoWarn>$(NoWarn);CA5394</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="TUnit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TEC.Core\TEC.Core.csproj" />
    <ProjectReference Include="..\samples\TEC.Core.SampleApi\TEC.Core.SampleApi.csproj" />
    <ProjectReference Include="..\samples\TEC.Core.LoadGenerator\TEC.Core.LoadGenerator.csproj" />
  </ItemGroup>

</Project>
