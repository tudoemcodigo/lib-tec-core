<Project Sdk="Microsoft.NET.Sdk">

  <!-- Framework, lock file e auditoria de pacotes em ../Directory.Build.props -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />
    <PackageReference Include="TUnit" Version="1.72.10" />
  </ItemGroup>

  <!-- ToListAsync (System.Linq.AsyncEnumerable) faz parte do .NET 10; no .NET 8 vem do pacote -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <PackageReference Include="System.Linq.AsyncEnumerable" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TEC.Core\TEC.Core.csproj" />
  </ItemGroup>

</Project>
