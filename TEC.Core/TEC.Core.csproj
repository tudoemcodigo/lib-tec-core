<Project Sdk="Microsoft.NET.Sdk">

  <!-- Configurações comuns (framework, analisadores, auditoria, lock file, determinismo e metadados) em ../Directory.Build.props -->
  <PropertyGroup>
    <RootNamespace>TEC.Core</RootNamespace>
  </PropertyGroup>

  <!-- Metadados do pacote NuGet (feed interno) -->
  <PropertyGroup>
    <Description>Blocos comuns para aplicações brasileiras: protege dados e senhas, valida e formata documentos, calcula dias úteis, escreve valores por extenso, importa e exporta planilhas e padroniza erros e respostas.</Description>
    <PackageTags>core;utils;cryptography;csv;business-days;brasil</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
  </ItemGroup>

</Project>
