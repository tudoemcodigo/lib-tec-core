<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Gerador de carga HTTP próprio (sem licença nem binário externo) para a API de exemplo (TEC.Core.SampleApi).
    Uso e opções da linha de comando em samples/README.md.
    Também é referenciado pelos testes de carga (TEC.Core.LoadTests), que usam a classe LoadRunner em processo.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- CA5394: Random com semente fixa é proposital (sorteios reproduzíveis de carga/fuzzing), não é uso de segurança -->
    <NoWarn>$(NoWarn);CA5394</NoWarn>
  </PropertyGroup>

  <!-- DocumentGenerator: CPFs e CNPJs válidos para o cenário de documentos -->
  <ItemGroup>
    <ProjectReference Include="..\..\TEC.Core\TEC.Core.csproj" />
  </ItemGroup>

</Project>
