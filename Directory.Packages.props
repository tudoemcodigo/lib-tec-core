<Project>

  <!--
    Central Package Management: a versão de cada pacote de terceiros é declarada uma única vez, aqui.
    Componentes TEC.* não entram aqui: use <TecReference Include="TEC.X" /> no csproj (build/Tec.Build.targets).
  -->
  <ItemGroup>
    <PackageVersion Include="BenchmarkDotNet" Version="0.15.8" />
    <PackageVersion Include="FsCheck" Version="3.5.0" />
    <PackageVersion Include="TUnit" Version="1.75.0" />
  </ItemGroup>

  <!--
    Microsoft.Extensions.* acompanha a versão major do .NET do alvo (net10.0): dependência pareada, atualizada à mão
    junto com o SDK, para não impor ao app uma versão diferente da do framework compartilhado.
  -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.12" />
  </ItemGroup>

</Project>
