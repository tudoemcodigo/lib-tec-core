<Project>

  <!--
    Central Package Management: a versão de cada pacote de terceiros é declarada uma única vez, aqui.
    Componentes TEC.* não entram aqui: use <TecReference Include="TEC.X" /> no csproj (build/Tec.Build.targets).
  -->
  <ItemGroup>
    <PackageVersion Include="BenchmarkDotNet" Version="0.15.8" />
    <PackageVersion Include="FsCheck" Version="3.4.0" />
    <PackageVersion Include="System.Linq.AsyncEnumerable" Version="10.0.12" />
    <PackageVersion Include="TUnit" Version="1.74.0" />
  </ItemGroup>

  <!--
    Microsoft.Extensions.* acompanha a versão do .NET de cada runtime (dependência pareada, atualizada à mão): um app
    ASP.NET Core 8 que usa o TEC.Core continua com as Abstractions 8.x do framework compartilhado, sem misturar 10.x.
  -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" Condition="'$(TargetFramework)' == 'net8.0'" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" Condition="'$(TargetFramework)' != 'net8.0'" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.2" Condition="'$(TargetFramework)' == 'net8.0'" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.12" Condition="'$(TargetFramework)' != 'net8.0'" />
  </ItemGroup>

</Project>
